APP_ENV=local
DATA_DIR=/data
LOG_LEVEL=INFO
API_PORT=8010

POSTGRES_DB=video_pipeline
POSTGRES_USER=video_pipeline
POSTGRES_PASSWORD=video_pipeline
DATABASE_URL=postgresql+psycopg://video_pipeline:video_pipeline@postgres:5432/video_pipeline

REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# CPU-first default. Use imported transcripts or script-derived rough cues.
ASR_PROVIDER=import
DEFAULT_CUE_SECONDS=8

# Leave empty until a real provider is selected.
LLM_PROVIDER=none
LLM_API_KEY=
